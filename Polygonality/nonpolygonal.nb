             "]"}], "]"}], "/", "ry"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"p2", "=", 
        RowBox[{"PairPosition", "[", 
         RowBox[{"M2", "[", 
          RowBox[{"[", 
