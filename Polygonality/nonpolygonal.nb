       "\[IndentingNewLine]", 
       RowBox[{"q2", "=", 
        RowBox[{"PairPosition", "[", 
         RowBox[{"M2", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "4"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"v2", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", "p2", "]"}], "]"}], "/", "rx"}], ",", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"q2", "\[Equal]", "0"}], ",", "q2", ",", 
