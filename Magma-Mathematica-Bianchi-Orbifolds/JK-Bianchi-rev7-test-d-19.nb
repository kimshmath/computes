Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"discOd", "[", "d_Integer", "]"}], ":=", 
   RowBox[{"Return", "[", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"d", ",", "4"}], "]"}], "==", "3"}], ",", "d", ",", 
      RowBox[{"4", "d"}]}], "]"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"LobachevskyLambda", "[", "x_Real", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "4"], " ", "\[ImaginaryI]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"PolyLog", "[", 
       RowBox[{"2", ",", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "2"}], "\[ImaginaryI]", " ", "x"}]]}], "]"}], "-", 
      RowBox[{"PolyLog", "[", 
       RowBox[{"2", ",", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", "\[ImaginaryI]", " ", "x"}]]}], "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d", "=", "43"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DD", "=", 
   RowBox[{"discOd", "[", "d", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"vol", "=", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"DD", "/", "12"}], " ", "*", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"JacobiSymbol", "[", 
           RowBox[{
            RowBox[{"-", "DD"}], ",", "k"}], "]"}], 
          RowBox[{"LobachevskyLambda", "[", 
           RowBox[{"Pi", " ", 
            RowBox[{"k", "/", "DD"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{"DD", "-", "1"}]}], "}"}]}], "]"}]}], "//", "N"}], "]"}]}],
    "]"}], ";"}]}], "Input",
 CellChangeTimes->{
  3.859595108065558*^9, {3.859595206883874*^9, 3.859595262344892*^9}},
 CellLabel->
  "In[754]:=",ExpressionUUID->"49395458-9020-4d93-b8ed-4eeb6a42878b"],

