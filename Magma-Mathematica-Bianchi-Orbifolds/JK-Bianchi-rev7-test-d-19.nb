          RowBox[{"temp", ",", "1"}], "]"}], "]"}]}], "]"}]}], ";"}]}], "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"IsomSphereList", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "\[LessEqual]", "fno"}], ",", 
    RowBox[{"i", "++"}], ",", 
    RowBox[{
     RowBox[{"IsomSphereList", "=", 
      RowBox[{"Append", "[", 
       RowBox[{"IsomSphereList", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{
          "lfacesPSL", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
           ",", 
          RowBox[{"IsomSphereRef", "[", 
           RowBox[{
           "lfacesPSL", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}], "]"}], ",", 
          RowBox[{
          "lfacesAdjacency", "\[LeftDoubleBracket]", "i", 
           "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], ";"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sys", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "\[LessEqual]", "fno"}], ",", 
    RowBox[{"i", "++"}], ",", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"sys", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s0", ",", "c0", ",", "r0"}], "}"}], "=", 
         RowBox[{"CircleMatrixToEuclidean", "[", 
          RowBox[{
           RowBox[{
           "IsomSphereList", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "3", 
           "\[RightDoubleBracket]"}], "]"}]}], ";", 
        RowBox[{"a0", "=", 
         RowBox[{"Re", "[", "c0", "]"}]}], ";", 
        RowBox[{"b0", "=", 
         RowBox[{"Im", "[", "c0", "]"}]}], ";", 
        RowBox[{"aa0", "=", 
         RowBox[{"Re", "[", "r0", "]"}]}], ";", 
        RowBox[{"bb0", "=", 
         RowBox[{"Im", "[", "r0", "]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"s0", "\[Equal]", "1"}], ",", 
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"xx", "-", "a0"}], ")"}], "2"], "+", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"yy", "-", "b0"}], ")"}], "2"], "+", 
            SuperscriptBox["zz", "2"], "-", 
            SuperscriptBox["r0", "2"]}], ">", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"xx", "-", "a0"}], ")"}], " ", "aa0"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"yy", "-", "b0"}], ")"}], " ", "bb0"}]}], ")"}], " ", 
            
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 FractionBox["1", "3"], "-", "a0"}], ")"}], " ", "aa0"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  FractionBox["1", "2"]}], "-", "b0"}], ")"}], " ", "bb0"}]}],
              ")"}]}], ">", "0"}]}], "]"}]}]}], "]"}], ";"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"AppendTo", "[", 
   RowBox[{"sys", ",", 
    RowBox[{"zz", ">", "0"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"reg", "=", 
   RowBox[{"ImplicitRegion", "[", 
    RowBox[{
     RowBox[{"Resolve", "[", 
      RowBox[{"sys", ",", 
       TemplateBox[{},
        "Reals"]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"xx", ",", "yy", ",", "zz"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MM", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sys2", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"sys", ",", 
     RowBox[{"{", 
      RowBox[{"0", "<", "zz", "<", "MM"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"reg2", "=", 
   RowBox[{"ImplicitRegion", "[", 
    RowBox[{
     RowBox[{"Resolve", "[", 
      RowBox[{"sys2", ",", 
       TemplateBox[{},
        "Reals"]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"xx", ",", "yy", ",", "zz"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"linv", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "\[LessEqual]", "fno"}], ",", 
    RowBox[{"i", "++"}], ",", 
    RowBox[{
     RowBox[{"m1", "=", 
      RowBox[{
      "lfacesPSL", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
     ";", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "i"}], ",", 
       RowBox[{"j", "\[LessEqual]", "fno"}], ",", 
       RowBox[{"j", "++"}], ",", 
       RowBox[{
        RowBox[{"m2", "=", 
         RowBox[{
         "lfacesPSL", "\[LeftDoubleBracket]", "j", 
          "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"m1", ".", "m2"}], "\[Equal]", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"linv", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}]}], "]"}], ";", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "\[Equal]", "j"}], ",", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<Coincide at i = j = \>\"", ",", "i"}], "]"}]}], 
            "]"}]}]}], "]"}], ";"}]}], "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<The pairs of inverse faces are \>\"", ",", "linv"}], "]"}], 
  ";"}]}], "Input",
