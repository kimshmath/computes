Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", "pp", ",", "q", ",", "r", ",", "sigma", ",", "tau"}], 
    "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "1", ",", "0", ",", 
     RowBox[{
      RowBox[{"Permutations", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"p", "+", "q", "+", "r"}], "]"}], "]"}], "[", 
      RowBox[{"[", "i", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"Permutations", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"p", "+", "q", "+", "r"}], "]"}], "]"}], "[", 
      RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.48025793413092*^9, 3.480257968415234*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"PermA", "=", 
   RowBox[{"Permutations", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"p", "+", "q", "+", "r"}], "]"}], "]"}]}], ";", 
  "\[IndentingNewLine]", 
  RowBox[{"PermB", "=", 
   RowBox[{"Permutations", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"pp", "+", "q", "+", "r"}], "]"}], "]"}]}], ";", 
  "\[IndentingNewLine]", 
  RowBox[{"PA", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"p", "+", "q", "+", "r"}], ")"}], "!"}]}], ";", 
  "\[IndentingNewLine]", 
  RowBox[{"PB", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"pp", "+", "q", "+", "r"}], ")"}], "!"}]}], ";", 
  "\[IndentingNewLine]", 
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "\[LessEqual]", "PA"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "\[LessEqual]", "PB"}], ",", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"VerifyConjectureSCPos", "[", 
            RowBox[{"p", ",", "pp", ",", "q", ",", "r", ",", 
             RowBox[{"PermA", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"PermB", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "==", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<False at\>\"", ",", 
             RowBox[{"PermA", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"PermB", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.4802580254766073`*^9, 3.480258054254745*^9}}],

