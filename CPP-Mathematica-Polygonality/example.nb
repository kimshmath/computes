Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", " ", 
   RowBox[{"Check", " ", "Random"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"p", "=", "4"}], ";", 
    RowBox[{"pp", "=", "2"}], ";", 
    RowBox[{"q", "=", "2"}], ";", 
    RowBox[{"r", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PermA", "=", 
     RowBox[{"Permutations", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"p", "+", "q", "+", "r"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PermB", "=", 
     RowBox[{"Permutations", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"pp", "+", "q", "+", "r"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PA", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "+", "q", "+", "r"}], ")"}], "!"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PB", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"pp", "+", "q", "+", "r"}], ")"}], "!"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TrialN", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"ind", "=", "1"}], ",", 
      RowBox[{"ind", "\[LessEqual]", "TrialN"}], ",", " ", 
      RowBox[{"ind", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"i", "=", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "PA"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"j", "=", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "PB"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xsol", "=", 
        RowBox[{"VerifyConjectureSC1", "[", 
         RowBox[{"p", ",", "pp", ",", "q", ",", "r", ",", 
          RowBox[{"PermA", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"PermB", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<A soution = \>\"", ",", 
         RowBox[{"xsol", "//", "MatrixForm"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "xsol", "]"}], "\[GreaterEqual]", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"p", "+", "q", "+", "r"}], ")"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "+", "q", "+", "r", "-", "1"}], ")"}], "/", 
            "2"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Solutions = \>\"", ",", " ", 
             RowBox[{"xsol", "//", "MatrixForm"}]}], "]"}], ";"}], " ", 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"xsolna", "=", 
           RowBox[{
            RowBox[{"Transpose", "[", "xsol", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"xsolnb", "=", 
           RowBox[{
            RowBox[{"Transpose", "[", "xsol", "]"}], "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"sa", "=", "0"}], ";", "\[IndentingNewLine]", 
          RowBox[{"sb", "=", "0"}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"k", "=", "1"}], ",", 
            RowBox[{"k", "\[LessEqual]", " ", 
             RowBox[{"Length", "[", "xsolna", "]"}]}], ",", " ", 
            RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"sa", "+=", 
              RowBox[{"Length", "[", 
               RowBox[{"xsolna", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"sb", "+=", 
              RowBox[{"Length", "[", 
               RowBox[{"xsolnb", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "]"}]}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<sigma, tau = \>\"", ",", 
            RowBox[{"PermA", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"PermB", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", "\"\<, Length = \>\"", ",", 
            
            RowBox[{"Length", "[", "xsol", "]"}], ",", 
            "\"\<, Number of a- & b-pairs used = \>\"", ",", " ", 
            RowBox[{"sa", "/", "2"}], ",", " ", "\"\< & \>\"", ",", " ", 
            RowBox[{"sb", "/", "2"}]}], "]"}], ";"}]}], "\[IndentingNewLine]",
         "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", "pp", ",", "q", ",", "r", ",", "sigma", ",", "tau"}], 
    "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "2", ",", "1", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3", ",", "2", ",", "4", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4", ",", "1", ",", "3"}], "}"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"VerifyConjectureSCPosMin", "[", 
    RowBox[{"p", ",", "pp", ",", "q", ",", "r", ",", "sigma", ",", "tau"}], 
    "]"}], "//", "MatrixForm"}]}]], "Input"]
},
