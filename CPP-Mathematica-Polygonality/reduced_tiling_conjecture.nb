Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MaxDegree", "[", "d_Integer", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", ",", "q", ",", "r", ",", " ", 
       RowBox[{"max", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"q", "=", "0"}], ",", 
        RowBox[{"q", "\[LessEqual]", 
         RowBox[{"Floor", "[", 
          RowBox[{"d", "/", "2"}], "]"}]}], ",", 
        RowBox[{"q", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"r", "=", "q"}], ",", 
           RowBox[{"r", "\[LessEqual]", 
            RowBox[{"Floor", "[", 
             RowBox[{"d", "/", "2"}], "]"}]}], ",", 
           RowBox[{"r", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"p", "=", 
             RowBox[{"d", "-", "q", "-", "r"}]}], ";", "\[IndentingNewLine]", 
            
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"q", "\[Equal]", "r", "\[Equal]", "0"}], ",", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"max", " ", "=", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"max", ",", " ", 
               RowBox[{
                RowBox[{"p", " ", "q", " ", "r"}], " ", "+", " ", 
                RowBox[{"2", " ", "q", " ", "r"}], " ", "+", " ", 
                RowBox[{"p", "^", "2"}]}]}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "max", "]"}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.4891364200726852`*^9, 3.4891364701708107`*^9}}],

