Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ReducedPMatrix", "[", 
     RowBox[{
     "p_Integer", ",", "q_Integer", ",", "r_Integer", ",", "tau_List"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "d", ",", "MM", ",", "MMEdge", ",", "i", ",", "j", ",", "k", ",", 
        "rvec", ",", "cz", ",", "ind", ",", "cedgez", ",", "NumberOfColumns", 
        ",", "NumberOfRows", ",", "bsvalue", ",", "x", ",", "MM1", ",", "MM2",
         ",", "i1", ",", "i2", ",", "NumberOfRows1", ",", "NumberOfRows2", 
        ",", " ", "IndAll"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"p", "<", 
          RowBox[{"Abs", "[", 
           RowBox[{"q", "-", "r"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Not Minimal\>\"", "]"}], ";", 
          RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"p", "+", "q", "+", "r"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"cz", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "+", "q", "+", "r"}], ")"}], "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"p", "+", "q", "+", "r", "-", "1"}], ")"}], "/", 
             "2"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cedgez", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "*", "d"}], "-", "p"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"MM", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"MMEdge", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", "r"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "\[LessEqual]", "q"}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"rvec", "=", "cz"}], ";", "\[IndentingNewLine]", 
             RowBox[{"ind", "=", 
              RowBox[{"PairPosition", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"p", "+", "q", "+", "i"}], ",", 
                 RowBox[{"p", "+", "j"}]}], "}"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"rvec", "=", 
              RowBox[{"ReplacePart", "[", 
               RowBox[{"rvec", ",", 
                RowBox[{"ind", "\[Rule]", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"rvec", "[", 
                    RowBox[{"[", "ind", "]"}], "]"}], "+", "1"}], ")"}]}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"MM", "=", 
              RowBox[{"Append", "[", 
               RowBox[{"MM", ",", "rvec"}], "]"}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"rvec", "=", "cedgez"}], ";", "\[IndentingNewLine]", 
             RowBox[{"rvec", "=", 
              RowBox[{"ReplacePart", "[", 
               RowBox[{"rvec", ",", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"q", "+", "i"}], "}"}], ",", 
                   RowBox[{"{", "j", "}"}]}], "}"}], "\[Rule]", "1"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"MMEdge", "=", 
              RowBox[{"Append", "[", 
               RowBox[{"MMEdge", ",", "rvec"}], "]"}]}], ";"}]}], 
           "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", "q"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "\[LessEqual]", "r"}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"rvec", "=", "cz"}], ";", "\[IndentingNewLine]", 
             RowBox[{"ind", "=", 
              RowBox[{"PairPosition", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"tau", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", "+", "i"}], "]"}], "]"}], ",", 
                 RowBox[{"tau", "[", 
                  RowBox[{"[", 
                   RowBox[{"p", "+", "q", "+", "j"}], "]"}], "]"}]}], "}"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"rvec", "=", 
              RowBox[{"ReplacePart", "[", 
               RowBox[{"rvec", ",", 
                RowBox[{"ind", "\[Rule]", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"rvec", "[", 
                    RowBox[{"[", "ind", "]"}], "]"}], "-", "1"}], ")"}]}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"MM", "=", 
              RowBox[{"Append", "[", 
               RowBox[{"MM", ",", "rvec"}], "]"}]}], ";", 
