          RowBox[{"d", "/", "2"}], "]"}]}], ",", 
        RowBox[{"q", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"r", "=", "q"}], ",", 
