                RowBox[{"MM1", "=", 
                 RowBox[{"Join", "[", 
                  RowBox[{"MM", ",", "MM1"}], "]"}]}], ";", "  ", 
                RowBox[{"(*", " ", 
                 RowBox[{
                  RowBox[{
                  "to", " ", "check", " ", "same", " ", "number", " ", "of", 
                   " ", "occurrences", " ", "for", " ", "mid"}], "-", 
                  "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
                RowBox[{"MM2", "=", 
                 RowBox[{"Join", "[", 
                  RowBox[{"MM", ",", "MM2"}], "]"}]}], ";", "  ", 
                RowBox[{"(*", " ", 
                 RowBox[{
                  RowBox[{
                  "to", " ", "check", " ", "same", " ", "number", " ", "of", 
