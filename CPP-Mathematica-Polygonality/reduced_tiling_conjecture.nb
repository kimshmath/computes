                  "+", 
                  RowBox[{"--", "b"}], "-", " ", "edges"}], " ", "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"NumberOfRows1", "=", 
                 RowBox[{"Length", "[", "MM1", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"NumberOfRows2", "=", 
