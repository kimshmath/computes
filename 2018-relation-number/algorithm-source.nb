            RowBox[{"d", "=", 
             RowBox[{"GCD", "[", 
              RowBox[{"s", ",", "wp"}], "]"}]}], ";", 
            RowBox[{"DD", "=", 
             RowBox[{"GCD", "[", 
              RowBox[{
               RowBox[{"s", " ", "m"}], ",", " ", "wp"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"mList2", "=", 
             RowBox[{"Divisors", "[", 
              RowBox[{"m", " ", 
               RowBox[{"d", " ", "/", " ", "DD"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j2", "=", "1"}], ",", 
              RowBox[{
               RowBox[{"j2", "\[LessEqual]", 
                RowBox[{"Length", "[", "mList2", "]"}]}], "&&", 
               RowBox[{"!", "flag"}]}], ",", 
              RowBox[{"j2", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"y", "=", 
                RowBox[{"mList2", "[", 
                 RowBox[{"[", "j2", "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"s", " ", "m", " ", "y"}], " ", "+", "DD"}], ",", 
                    "wp"}], "]"}], "\[Equal]", "0"}], "||", 
                  RowBox[{
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"s", " ", "m", " ", "y"}], "-", "DD"}], ",", 
                    "wp"}], "]"}], "\[Equal]", "0"}], "||", 
                  RowBox[{
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"s", " ", "m", " ", "y"}], "+", "DD"}], ",", 
                    RowBox[{
                    RowBox[{"s", " ", "m"}], "-", "wp"}]}], "]"}], "\[Equal]",
                    "0"}], "||", 
                  RowBox[{
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"s", " ", "m", " ", "y"}], "-", "DD"}], ",", 
                    RowBox[{
                    RowBox[{"s", " ", "m"}], "-", "wp"}]}], "]"}], "\[Equal]",
                    "0"}]}], ",", 
                 RowBox[{
                  RowBox[{"flag", "=", "True"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"result", "=", 
                   RowBox[{"Append", "[", 
                    RowBox[{"result", ",", 
                    RowBox[{"{", 
                    RowBox[{"w", ",", "m", ",", "y"}], "}"}]}], "]"}]}], ";", 
                  
                  RowBox[{"exc", "=", 
                   RowBox[{"Union", "[", 
                    RowBox[{"exc", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"s", ",", "wp"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"s", ",", 
                    RowBox[{
                    RowBox[{"s", " ", "m"}], " ", "-", " ", "wp"}]}], "}"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"s", ",", " ", "DD"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"s", ",", 
                    RowBox[{"-", "DD"}]}], "}"}]}], "}"}]}], "]"}]}]}]}], 
                "]"}]}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", "flag"}], ",", 
           RowBox[{"ltmp", "=", 
            RowBox[{"Append", "[", 
             RowBox[{"ltmp", ",", "i"}], "]"}]}]}], "]"}], ";"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"lt", "=", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"lt", "[", 
          RowBox[{"[", "ltmp", "]"}], "]"}], ",", 
         RowBox[{"s", " ", "M"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "lt", "]"}], "\[Equal]", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{"True", ",", "result", ",", "exc"}], "}"}], "]"}], ";"}]}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<For s = \>\"", ",", "s", ",", 
        "\"\<, the following remainders are not eliminated: \>\"", ",", "lt", 
        ",", "\"\< modulo \>\"", ",", "M", ",", "\"\< * s \>\""}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{"False", ",", "lt"}], "}"}], "]"}], ";"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.756097649955209*^9, 3.756097649956635*^9}, 
   3.756098066102923*^9, {3.756506573124341*^9, 3.756506598292859*^9}, {
   3.756506828523375*^9, 3.756506865365362*^9}, {3.756506975155176*^9, 
