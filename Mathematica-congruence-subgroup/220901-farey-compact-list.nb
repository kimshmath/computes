Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "<=", "15400"}], ",", 
     RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "=", 
       RowBox[{"Prime", "[", "i", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"r", "=", "1"}], ",", 
        RowBox[{"r", "<=", "17"}], ",", 
        RowBox[{"r", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"q", "=", 
          RowBox[{"p", "^", "r"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"q", ">", "168000"}], ",", 
           RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Summatory", "[", 
             RowBox[{"Floor", "[", 
              RowBox[{"Sqrt", "[", "q", "]"}], "]"}], "]"}], "==", 
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"q", "+", 
                RowBox[{"q", "/", "p"}]}], ")"}], "/", "3"}], "]"}]}], ",", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Found at q = \>\"", ",", " ", "q"}], "]"}]}], "]"}], 
         ";"}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}], ";"}]}]], "Input",ExpressionUUID->"0abb50e4-932e-4ec5-b9ee-\
f5198c121b4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"n", "=", "1"}], ",", 
   RowBox[{"n", "<=", "20000000"}], ",", 
   RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Summatory", "[", 
        RowBox[{"Floor", "[", 
         RowBox[{"Sqrt", "[", "n", "]"}], "]"}], "]"}], "==", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"GG0Index", "[", "n", "]"}], "-", 
          RowBox[{"v3", "[", "n", "]"}]}], ")"}], "/", "3"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Found at n = \>\"", ",", " ", "n"}], "]"}]}], "]"}], 
