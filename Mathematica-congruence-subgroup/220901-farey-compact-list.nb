Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PrimeFactors", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Take", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"FactorInteger", "[", "n", "]"}], "]"}], ",", "1"}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.875412996739695*^9, 3.875413023787072*^9}, 
   3.875413656431364*^9},
 CellTags->"FactorInteger_templates",
 CellLabel->
  "In[109]:=",ExpressionUUID->"aa75406a-e0aa-4a51-a213-db0f2f517abd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GG0Index", "[", "n_Integer", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", "s", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"l", "=", 
       RowBox[{"PrimeFactors", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"s", "=", "n"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"Length", "[", "l", "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"s", "*=", 
          RowBox[{"1", "+", 
           RowBox[{"1", "/", 
            RowBox[{"l", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "s", "]"}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.875413699642861*^9, 3.8754137603662653`*^9}},
 CellLabel->
  "In[116]:=",ExpressionUUID->"f7503bfc-2d8e-4b3f-99c6-ca22bfcc226e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"v3", "[", "n_Integer", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", "s", ",", "i", ",", "r"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"n", ",", "9"}], "]"}], "==", "0"}], ",", 
        RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"l", "=", 
       RowBox[{"PrimeFactors", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"s", "=", "1"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"Length", "[", "l", "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"r", "=", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"l", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "3"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"r", "==", "2"}], ",", 
           RowBox[{"Return", "[", "0", "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"r", "==", "1"}], ",", 
             RowBox[{"s", "*=", "2"}]}], "]"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "s", "]"}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.875413030822032*^9, 3.875413104106539*^9}, {
  3.8754131517069674`*^9, 3.875413249454063*^9}, {3.875413285170141*^9, 
