Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SqMaxSpPoly", "[", "n_Integer", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "t", ",", "iterateMax", ",", "iterate", ",", "vw", ",", "vb", ",", "k", 
       ",", "Found", ",", "unclaimed", ",", "mpos", ",", "m", ",", "j", ",", 
       "j1", ",", "res", ",", "m1", ",", 
       RowBox[{"cpt", "=", "False"}], ",", 
       RowBox[{"v2count", "=", "0"}], ",", 
       RowBox[{"v3count", "=", "0"}], ",", "v2value", ",", "v3value"}], "}"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"iterateMax", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"GG0Index", "[", "n", "]"}], "-", 
          RowBox[{"v3", "[", "n", "]"}]}], ")"}], "/", "3"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"t", "=", 
       RowBox[{"Floor", "[", 
        RowBox[{"Sqrt", "[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"v2value", "=", 
       RowBox[{"v2", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"v3value", "=", 
       RowBox[{"v3", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"vw", "=", 
       RowBox[{"Denominator", "[", 
        RowBox[{"FareySequence", "[", "t", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vb", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"-", "4"}], ",", 
         RowBox[{
          RowBox[{"Length", "[", "vw", "]"}], "-", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"k", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Found", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"iterate", "=", "1"}], ",", 
        RowBox[{
         RowBox[{"iterate", "<=", "iterateMax"}], "&&", 
         RowBox[{"!", "Found"}]}], ",", 
        RowBox[{"iterate", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<", 
            RowBox[{"Length", "[", "vw", "]"}]}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"vb", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "!=", 
               RowBox[{"-", "4"}]}], ",", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"Check", " ", "if", " ", "even"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"v2count", "<", "v2value"}], ",", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "^", "2"}], "+", 
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}], "^", "2"}]}], ",", 
                   "n"}], "]"}], "==", "0"}], ",", 
                RowBox[{
                 RowBox[{"vb", "=", 
                  RowBox[{"ReplacePart", "[", 
                   RowBox[{"vb", ",", 
                    RowBox[{"j", "->", 
                    RowBox[{"-", "2"}]}]}], "]"}]}], ";", 
                 RowBox[{"v2count", "++"}], ";", 
                 RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"Check", " ", "if", " ", "odd"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"v3count", "<", "v3value"}], ",", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "^", "2"}], "+", 
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], 
                    RowBox[{"vw", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}]}], "+", 
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}], "^", "2"}]}], ",", 
                   "n"}], "]"}], "==", "0"}], ",", 
                RowBox[{
                 RowBox[{"vb", "=", 
                  RowBox[{"ReplacePart", "[", 
                   RowBox[{"vb", ",", 
                    RowBox[{"j", "->", 
                    RowBox[{"-", "3"}]}]}], "]"}]}], ";", 
                 RowBox[{"v3count", "++"}], ";", 
                 RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j1", "=", 
               RowBox[{"j", "+", "1"}]}], ",", 
              RowBox[{"j1", "<", 
               RowBox[{"Length", "[", "vw", "]"}]}], ",", 
              RowBox[{"j1", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"vb", "[", 
                   RowBox[{"[", "j1", "]"}], "]"}], "==", 
                  RowBox[{"-", "4"}]}], "&&", 
                 RowBox[{
                  RowBox[{"Mod", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], 
                    RowBox[{"vw", "[", 
                    RowBox[{"[", "j1", "]"}], "]"}]}], "+", 
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}], 
                    RowBox[{"vw", "[", 
                    RowBox[{"[", 
                    RowBox[{"j1", "+", "1"}], "]"}], "]"}]}]}], ",", "n"}], 
                   "]"}], "==", "0"}]}], ",", 
                RowBox[{
                 RowBox[{"vb", "=", 
                  RowBox[{"ReplacePart", "[", 
                   RowBox[{"vb", ",", 
                    RowBox[{"j", "->", 
                    RowBox[{"++", "k"}]}]}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"vb", "=", 
                  RowBox[{"ReplacePart", "[", 
                   RowBox[{"vb", ",", 
                    RowBox[{"j1", "->", "k"}]}], "]"}]}], ";", 
                 RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"unclaimed", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"vb", ",", 
             RowBox[{"-", "4"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
            "If", " ", "no", " ", "black", " ", "vertices", " ", "are", " ", 
             "labeled"}], " ", "-", "4"}], ",", " ", 
           RowBox[{
           "then", " ", "our", " ", "computation", " ", "is", " ", "complete",
             " ", "and", " ", "safe"}]}], " ", "*)"}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"unclaimed", "==", 
            RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Found", "=", "True"}], ";", 
            RowBox[{"res", "=", 
             RowBox[{"Max", "[", "vw", "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Break", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
         ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"mpos", "=", "1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"m", "=", 
          RowBox[{"Plus", "[", 
           RowBox[{
            RowBox[{"vw", "[", 
             RowBox[{"[", 
              RowBox[{"unclaimed", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"vw", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"unclaimed", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], "]"}], "]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "2"}], ",", 
           RowBox[{"j", "<=", 
            RowBox[{"Length", "[", "unclaimed", "]"}]}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"m1", "=", 
             RowBox[{"Plus", "[", 
              RowBox[{
               RowBox[{"vw", "[", 
                RowBox[{"[", 
                 RowBox[{"unclaimed", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}], ",", 
               RowBox[{"vw", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"unclaimed", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "+", "1"}], "]"}], "]"}]}],
               "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"m", "<", "m1"}], ",", 
              RowBox[{
               RowBox[{"mpos", "=", "j"}], ";", 
               RowBox[{"m", "=", "m1"}], ";"}]}], "\[IndentingNewLine]", 
             "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"j", "=", 
          RowBox[{"unclaimed", "[", 
           RowBox[{"[", "mpos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"vw", " ", "=", " ", 
          RowBox[{"Insert", "[", 
           RowBox[{"vw", ",", 
            RowBox[{
             RowBox[{"vw", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "+", 
             RowBox[{"vw", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ",", 
            RowBox[{"j", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"vb", "=", 
          RowBox[{"Insert", "[", 
           RowBox[{"vb", ",", 
            RowBox[{"-", "4"}], ",", 
            RowBox[{"j", "+", "1"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{"vw", ",", "vb"}], "}"}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.880687410121848*^9, 3.880687412866818*^9}, {
  3.880687448351123*^9, 3.8806874495382853`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"717aa1a9-4ba3-4d31-929d-010602b30450"],

