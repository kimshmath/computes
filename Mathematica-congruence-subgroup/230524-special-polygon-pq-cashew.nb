Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SumTripleSpPoly", "[", "n_Integer", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "t", ",", "iterateMax", ",", "iterate", ",", "vw", ",", "vb", ",", "k", 
       ",", "Found", ",", "unclaimed", ",", "mpos", ",", "m", ",", "j", ",", 
       "j1", ",", "res", ",", "m1", ",", 
       RowBox[{"cpt", "=", "False"}], ",", 
       RowBox[{"v2count", "=", "0"}], ",", 
       RowBox[{"v3count", "=", "0"}], ",", "v2value", ",", "v3value"}], "}"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"iterateMax", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"GG0Index", "[", "n", "]"}], "-", 
          RowBox[{"v3", "[", "n", "]"}]}], ")"}], "/", "3"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"t", "=", 
       RowBox[{"Floor", "[", 
        RowBox[{"Sqrt", "[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"v2value", "=", 
       RowBox[{"v2", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"v3value", "=", 
       RowBox[{"v3", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"vw", "=", 
       RowBox[{"Denominator", "[", 
        RowBox[{"FareySequence", "[", "t", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vb", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"-", "4"}], ",", 
         RowBox[{
          RowBox[{"Length", "[", "vw", "]"}], "-", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"k", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Found", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"iterate", "=", "1"}], ",", 
        RowBox[{
         RowBox[{"iterate", "<=", "iterateMax"}], "&&", 
         RowBox[{"!", "Found"}]}], ",", 
        RowBox[{"iterate", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<", 
            RowBox[{"Length", "[", "vw", "]"}]}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"vb", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "!=", 
               RowBox[{"-", "4"}]}], ",", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"Check", " ", "if", " ", "even"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"v2count", "<", "v2value"}], ",", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "^", "2"}], "+", 
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}], "^", "2"}]}], ",", 
                   "n"}], "]"}], "==", "0"}], ",", 
                RowBox[{
                 RowBox[{"vb", "=", 
                  RowBox[{"ReplacePart", "[", 
                   RowBox[{"vb", ",", 
                    RowBox[{"j", "->", 
                    RowBox[{"-", "2"}]}]}], "]"}]}], ";", 
                 RowBox[{"v2count", "++"}], ";", 
                 RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"Check", " ", "if", " ", "odd"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"v3count", "<", "v3value"}], ",", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "^", "2"}], "+", 
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], 
                    RowBox[{"vw", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}]}], "+", 
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}], "^", "2"}]}], ",", 
                   "n"}], "]"}], "==", "0"}], ",", 
                RowBox[{
                 RowBox[{"vb", "=", 
                  RowBox[{"ReplacePart", "[", 
                   RowBox[{"vb", ",", 
                    RowBox[{"j", "->", 
                    RowBox[{"-", "3"}]}]}], "]"}]}], ";", 
                 RowBox[{"v3count", "++"}], ";", 
                 RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j1", "=", 
               RowBox[{"j", "+", "1"}]}], ",", 
              RowBox[{"j1", "<", 
               RowBox[{"Length", "[", "vw", "]"}]}], ",", 
              RowBox[{"j1", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"vb", "[", 
                   RowBox[{"[", "j1", "]"}], "]"}], "==", 
                  RowBox[{"-", "4"}]}], "&&", 
                 RowBox[{
                  RowBox[{"Mod", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], 
                    RowBox[{"vw", "[", 
                    RowBox[{"[", "j1", "]"}], "]"}]}], "+", 
                    RowBox[{
                    RowBox[{"vw", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}], 
                    RowBox[{"vw", "[", 
                    RowBox[{"[", 
                    RowBox[{"j1", "+", "1"}], "]"}], "]"}]}]}], ",", "n"}], 
                   "]"}], "==", "0"}]}], ",", 
                RowBox[{
                 RowBox[{"vb", "=", 
                  RowBox[{"ReplacePart", "[", 
                   RowBox[{"vb", ",", 
                    RowBox[{"j", "->", 
                    RowBox[{"++", "k"}]}]}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"vb", "=", 
                  RowBox[{"ReplacePart", "[", 
                   RowBox[{"vb", ",", 
                    RowBox[{"j1", "->", "k"}]}], "]"}]}], ";", 
                 RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"unclaimed", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"vb", ",", 
             RowBox[{"-", "4"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
            "If", " ", "no", " ", "black", " ", "vertices", " ", "are", " ", 
             "labeled"}], " ", "-", "4"}], ",", " ", 
           RowBox[{
           "then", " ", "our", " ", "computation", " ", "is", " ", "complete",
             " ", "and", " ", "safe"}]}], " ", "*)"}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"unclaimed", "==", 
            RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Found", "=", "True"}], ";", 
            RowBox[{"res", "=", 
             RowBox[{"Max", "[", "vw", "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Break", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
         ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{"vw", ",", "vb"}], "}"}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8810988951139917`*^9, 3.881098897693933*^9}, {
