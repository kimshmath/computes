Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SumTriple", "[", "n_Integer", "]"}], ":=", "\[IndentingNewLine]", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "t", ",", "iterateMax", ",", "v", ",", "iterate", ",", "vw", ",", "vb", 
       ",", "vn", ",", "x0", ",", "y0", ",", "a", ",", "b", ",", "ap", ",", 
       "bp", ",", "k", ",", "Found", ",", "unclaimed", ",", "mpos", ",", "m", 
       ",", "j", ",", "j1", ",", "res", ",", "m1", ",", 
       RowBox[{"cpt", "=", "False"}], ",", "lF", ",", 
       RowBox[{"v2count", "=", "0"}], ",", 
       RowBox[{"v3count", "=", "0"}], ",", "v2value", ",", "v3value", ",", 
       "FreeSides"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"iterateMax", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"GG0Index", "[", "n", "]"}], "-", 
          RowBox[{"v3", "[", "n", "]"}]}], ")"}], "/", "3"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"v", "=", 
       RowBox[{"Floor", "[", 
        RowBox[{"Sqrt", "[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"v2value", "=", 
       RowBox[{"v2", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"v3value", "=", 
       RowBox[{"v3", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"FreeSides", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"lF", "=", 
       RowBox[{"FareySequence", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vw", "=", 
       RowBox[{"Denominator", "[", "lF", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"vn", "=", 
       RowBox[{"Numerator", "[", "lF", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vb", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"-", "4"}], ",", 
         RowBox[{
          RowBox[{"Length", "[", "vw", "]"}], "-", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"k", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Found", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"iterate", "=", "1"}], ",", 
        RowBox[{
         RowBox[{"iterate", "<=", "iterateMax"}], "&&", 
         RowBox[{"!", "Found"}]}], ",", 
        RowBox[{"iterate", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<", 
            RowBox[{"Length", "[", "vw", "]"}]}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"a", "=", 
             RowBox[{"vw", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"b", "=", 
             RowBox[{"vw", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"vb", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "!=", 
               RowBox[{"-", "4"}]}], ",", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"Check", " ", "if", " ", "even"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"v2count", "<", "v2value"}], ",", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"a", "^", "2"}], "+", 
                    RowBox[{"b", "^", "2"}]}], ",", "n"}], "]"}], "==", "0"}],
                 ",", 
                RowBox[{
                 RowBox[{"vb", "=", 
                  RowBox[{"ReplacePart", "[", 
                   RowBox[{"vb", ",", 
                    RowBox[{"j", "->", 
                    RowBox[{"-", "2"}]}]}], "]"}]}], ";", 
                 RowBox[{"v2count", "++"}], ";", 
                 RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"Check", " ", "if", " ", "odd"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"v3count", "<", "v3value"}], ",", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"a", "^", "2"}], "+", 
                    RowBox[{"a", " ", "b"}], "+", 
                    RowBox[{"b", "^", "2"}]}], ",", "n"}], "]"}], "==", "0"}],
                 ",", 
                RowBox[{
                 RowBox[{"vb", "=", 
                  RowBox[{"ReplacePart", "[", 
                   RowBox[{"vb", ",", 
                    RowBox[{"j", "->", 
                    RowBox[{"-", "3"}]}]}], "]"}]}], ";", 
                 RowBox[{"v3count", "++"}], ";", 
                 RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"ap", "=", 
             RowBox[{"vn", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"bp", "=", 
             RowBox[{"vn", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"x0", "=", 
             RowBox[{"n", " ", "bp"}]}], ";", 
            RowBox[{"y0", "=", 
             RowBox[{
              RowBox[{"-", "n"}], " ", "ap"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"t", "=", 
             RowBox[{"Ceiling", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x0", "-", "v"}], ")"}], "/", "b"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"x0", "=", 
             RowBox[{"x0", "-", 
              RowBox[{"b", " ", "t"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"y0", "=", 
             RowBox[{"y0", " ", "+", " ", 
              RowBox[{"a", " ", "t"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"y0", "<=", " ", "v"}], ",", 
              RowBox[{"vb", "=", 
               RowBox[{"ReplacePart", "[", 
                RowBox[{"vb", ",", 
                 RowBox[{"j", "->", "0"}]}], "]"}]}]}], "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"unclaimed", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"vb", ",", 
             RowBox[{"-", "4"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
