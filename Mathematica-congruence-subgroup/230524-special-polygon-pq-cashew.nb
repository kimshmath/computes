Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "5"}], ",", 
    RowBox[{"i", "<=", "20"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"q", "=", 
      RowBox[{"Prime", "[", "i", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "<=", "i"}], ",", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"Prime", "[", "j", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"p", "<", 
           RowBox[{"3", 
            RowBox[{"q", "/", "4"}]}]}], ",", " ", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"l", "=", 
         RowBox[{
          RowBox[{"SqStartSpPoly", "[", 
           RowBox[{"p", "*", "q"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<At n = \>\"", ",", "p", ",", "\"\<*\>\"", ",", "q", ",", 
            "\"\<, we see \>\"", ",", "q", ",", "\"\< appears \>\"", ",", " ", 
            RowBox[{"Count", "[", 
             RowBox[{"l", ",", "q"}], "]"}], ",", "\"\< times\>\""}], "]"}], 
          ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"q", "==", 
           RowBox[{"Max", "[", "l", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<At (p,q) = (\>\"", ",", "p", ",", "\"\<,\>\"", ",", "q", 
             ",", "\"\<): \>\"", ",", "\"\<True!\>\""}], "]"}], ";"}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<At (p,q) = (\>\"", ",", "p", ",", "\"\<,\>\"", ",", "q", ",", 
            "\"\<)\>\"", ",", "\"\<False!\>\""}], "]"}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.880753867255204*^9, 3.880753872192823*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"e7690e52-8a74-4710-91d5-167ca34cf467"],

