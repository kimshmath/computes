Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"j", "=", "2"}], ",", 
    RowBox[{"j", "<=", "100"}], ",", 
    RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"PrimeQ", "[", "j", "]"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"IntegerQ", "[", 
           RowBox[{"Sqrt", "[", "j", "]"}], "]"}], "&&", 
          RowBox[{"PrimeQ", "[", 
           RowBox[{"Sqrt", "[", "j", "]"}], "]"}]}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<n = \>\"", ",", "j", ",", "\"\< and diff = \>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Floor", "[", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"4", 
              RowBox[{"j", "/", "3"}]}], "]"}], "]"}], "-", 
           RowBox[{"Floor", "[", 
            RowBox[{"Sqrt", "[", "j", "]"}], "]"}]}], "//", "N"}]}], "]"}]}], 
      "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.8783288742779512`*^9, 3.8783289589064703`*^9}, {
  3.8783290120782747`*^9, 3.878329025747675*^9}, {3.878337746457714*^9, 
