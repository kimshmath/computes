Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"x", "=", "1"}], ",", 
   RowBox[{"x", "<=", "1000"}], ",", 
   RowBox[{"x", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<x = \>\"", ",", "x", ",", "\"\< and diff = \>\"", ",", 
      RowBox[{
       RowBox[{"Floor", "[", 
        RowBox[{"Sqrt", "[", "x", "]"}], "]"}], "-", 
       RowBox[{"Floor", "[", 
        RowBox[{"x", "/", 
         RowBox[{"Floor", "[", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"4", 
            RowBox[{"x", "/", "3"}]}], "]"}], "]"}]}], "]"}]}]}], "]"}], 
    ";"}]}], "]"}]], "Input",
