Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"n", "=", "1"}], ",", 
   RowBox[{"n", "<=", "180000"}], ",", 
   RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Summatory", "[", 
        RowBox[{"Floor", "[", 
         RowBox[{"Sqrt", "[", "n", "]"}], "]"}], "]"}], "==", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"GG0Index", "[", "n", "]"}], "-", 
          RowBox[{"v3", "[", "n", "]"}]}], ")"}], "/", "3"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Found at n = \>\"", ",", " ", "n"}], "]"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"n", ",", "10000"}], "]"}], "==", "0"}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<n is \>\"", "n"}], "]"}]}], "]"}], ";"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.875495432861754*^9, 3.875495480219392*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"c2af11fd-8cbb-4efe-bad7-67f359709cc1"],

