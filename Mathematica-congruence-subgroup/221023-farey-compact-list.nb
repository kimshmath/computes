Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<=", "1000"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"PrimeQ", "[", "i", "]"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<i = \>\"", ",", "i", ",", "\"\< and the diff = \>\"", ",", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"4", 
            RowBox[{
             RowBox[{"Sqrt", "[", "i", "]"}], "/", "Pi"}]}], "]"}], "-", 
          RowBox[{"Floor", "[", 
           RowBox[{"Sqrt", "[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.875654948238379*^9, 3.875655017551075*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"21703761-d7f0-4530-b76b-c89b8f836076"],

