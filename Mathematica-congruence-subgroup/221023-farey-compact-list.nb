Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PrimeFactors", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Take", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"FactorInteger", "[", "n", "]"}], "]"}], ",", "1"}], "]"}], 
