Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "<=", "16350"}], ",", 
     RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "=", 
       RowBox[{"Prime", "[", "i", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"r", "=", "1"}], ",", 
        RowBox[{"r", "<=", "17"}], ",", 
        RowBox[{"r", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"q", "=", 
          RowBox[{"p", "^", "r"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"q", ">", "180000"}], ",", 
           RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Summatory", "[", 
             RowBox[{"Floor", "[", 
              RowBox[{"Sqrt", "[", "q", "]"}], "]"}], "]"}], "==", 
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"q", "+", 
                RowBox[{"q", "/", "p"}]}], ")"}], "/", "3"}], "]"}]}], ",", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Found at q = \>\"", ",", " ", "q"}], "]"}]}], "]"}], 
         ";"}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}], ";"}]}]], "Input",
