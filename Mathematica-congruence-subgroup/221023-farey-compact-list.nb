Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"v3multi", "[", "t_Integer", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"t", "<=", "0"}], ",", 
        RowBox[{"Return", "[", "1", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"t", "==", "1"}], ",", 
        RowBox[{"Return", "[", "3", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"t", ">", "1"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"6", "t"}], "-", "5"}], ")"}], 
          RowBox[{"v3multi", "[", 
           RowBox[{"t", "-", "1"}], "]"}]}], "]"}]}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.875492695462058*^9, 3.875492787707336*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"69c9ff1c-cdb4-48b4-aa1f-826614ff3e77"],

