   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"i0", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"Prime", "[", "i0", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"EulerPhi", "[", "i", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Floor", "[", 
         RowBox[{"Sqrt", "[", "p", "]"}], "]"}], "+", "1"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "S", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"j", "=", 
    RowBox[{"i0", "+", "1"}]}], ",", 
   RowBox[{"j", "<=", "2500"}], ",", 
   RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p0", "=", "p"}], ";", "\[IndentingNewLine]", 
    RowBox[{"p", "=", 
     RowBox[{"Prime", "[", "j", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"S", "+=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"EulerPhi", "[", "i", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"Sqrt", "[", "p0", "]"}], "]"}], "+", "2"}], ",", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"Sqrt", "[", "p", "]"}], "]"}], "+", "1"}]}], "}"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"T", "=", 
     RowBox[{"Floor", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "+", "1"}], ")"}], "/", "3"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<(p, Summatory[Floor[Sqrt[p]]], Floor[(p+1)/3]) = (\>\"", ",", "p",
         ",", " ", "\"\<, \>\"", ",", " ", "S", ",", " ", "\"\<, \>\"", ",", 
        " ", "T", ",", " ", "\"\<)\>\""}], "]"}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"S", "==", "T"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Compact at p = \>\"", ",", "p"}], "]"}], ";", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"l", ",", "p"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"S", ">", "T"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Reversed at p = \>\"", ",", "p"}], "]"}], ";", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"l", ",", "p"}], "]"}]}]}], "]"}], ";"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
