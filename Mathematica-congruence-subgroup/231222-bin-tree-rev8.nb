Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"Prime", "[", "4", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"EulerPhi", "[", "i", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Floor", "[", 
        RowBox[{"Sqrt", "[", "p", "]"}], "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "S", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"j", "=", "5"}], ",", 
   RowBox[{"j", "<=", "2500"}], ",", 
   RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p0", "=", "p"}], ";", "\[IndentingNewLine]", 
    RowBox[{"p", "=", 
     RowBox[{"Prime", "[", "j", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"S", "+=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"EulerPhi", "[", "i", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"Sqrt", "[", "p0", "]"}], "]"}], "+", "1"}], ",", 
         RowBox[{"Floor", "[", 
          RowBox[{"Sqrt", "[", "p", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"T", "=", 
     RowBox[{"Floor", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "+", "1"}], ")"}], "/", "3"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<p = \>\"", ",", "p"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"S", "==", "T"}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Compact at p = \>\"", ",", "p"}], "]"}]}], "]"}], ";"}]}],
