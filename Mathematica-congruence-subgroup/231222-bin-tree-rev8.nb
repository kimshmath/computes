Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "p_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", "3"}], "-", 
       RowBox[{"3", "/", 
        RowBox[{"Pi", "^", "2"}]}]}], ")"}], "p"}], "-", 
    RowBox[{
     RowBox[{"Sqrt", "[", "p", "]"}], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"Log", "[", "p", "]"}], "/", "4"}]}], ")"}]}], "-", 
    RowBox[{"2", "/", "3"}]}]}], ";"}], "\[IndentingNewLine]", 
